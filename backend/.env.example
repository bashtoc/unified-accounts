NODE_ENV=production
PORT=4000
API_HOST_PORT=4002
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-mysql-root-password
MYSQL_DATABASE=safer_unified
MYSQL_USER=safer
MYSQL_PASSWORD=replace-with-a-long-random-mysql-password
DATABASE_URL=mysql://safer:replace-with-a-long-random-mysql-password@mysql:3306/safer_unified
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
MONITORING_ADMIN_REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=https://signal.saference.com
VITE_API_URL=http://localhost:4000/api/v1
OTP_TTL_MINUTES=10
OTP_PEPPER=replace-with-random-otp-pepper
API_KEY_PEPPER=replace-with-random-api-key-pepper
# Provision Signal operators directly in the Signal database. The bootstrap script
# reads these values once; operator login then uses email OTP.
MONITORING_ADMIN_BOOTSTRAP_EMAIL=operator@saference.com
MONITORING_ADMIN_BOOTSTRAP_NAME=Signal Operations
MONITORING_ADMIN_BOOTSTRAP_ROLE=OWNER
CF_ACCOUNT_ID=optional-cloudflare-account-id
CF_API_TOKEN=optional-cloudflare-api-token
MAIL_FROM_EMAIL=optional-sender@example.com
